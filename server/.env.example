# Server
PORT=3000
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/fitness_goal_system

# JWT (required for auth)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional: CORS origin (default allows localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
